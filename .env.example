# ==============================================================================
# MANDIQ CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env and configure the values for your environment.
# In accordance with MandiQ Agent Constraints (AC-004), cryptographic secrets
# are FAIL-CLOSED: if unset or empty in production, the application will refuse to start.

# Project root is derived from the installed repository; do not set it.

# Execution Environment: 'development' | 'production' | 'test'
ENVIRONMENT=development

# Database Connection URL
# Default local development/test fallback: SQLite 3
DATABASE_URL=sqlite:///mandiq.db
# Production Target: PostgreSQL 16
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mandiq

# Redis Connection URL (Sorted Sets for DCDQ queue & atomic slot locks)
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# FAIL-CLOSED CRYPTOGRAPHIC SECRETS (AC-004 / REQ-004)
# MUST be set with secure random strings in production.
# Hardcoded fallback default values are strictly prohibited.
# ------------------------------------------------------------------------------
# Secret key for HMAC-SHA256 token generation (Gate Passes, Slot Booking Tokens)
MANDIQ_SECRET_HMAC_KEY=

# Secret key for DBT Multi-Signature Payout Authorization (Dual-signature validation)
MANDIQ_PAYOUT_SECRET_KEY=

# ------------------------------------------------------------------------------
# ALGORITHMIC ENGINE PARAMETERS
# ------------------------------------------------------------------------------
# Moisture Perishability Exponential Decay Rate (k) for DCDQ Scoring
# S_moisture = 100 * (1 - e^(-k * (Moisture - M_safe)))
MANDIQ_MOISTURE_DECAY_K=0.8

# ------------------------------------------------------------------------------
# CORS CONFIGURATION
# ------------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
